  "cards": [
    {
      "dot": "violet",
      "title": "Who decides what",
      "items": [
        "LLM: understands the request, picks the tool, writes the answer",
        "Code (rules.py): breaches, priority, ticket-id and summary",
        "Tools: execute lookups, guards, ticket creation; return dicts, never raise"
      ]
    },
    {
      "dot": "amber",
      "title": "Enforced in code, not just the prompt",
      "items": [
        "P1 only if availability < 95.0 (is_priority_justified)",
        "Existing open ticket returns status exists, no second ticket",
        "No tool changes the network; the agent has only two tools"
      ]
    },
    {
      "dot": "emerald",
      "title": "State is not a database",
      "items": [
        "Tickets live in session state; fixture ticket TCK-1007 is read-only",
        "Dev UI keeps sessions in a local SQLite file (.adk/session.db)",
        "No central ticket system exists in this repo"
      ]
    },
    {
      "dot": "orange",
      "title": "Contract: get_cell_kpis(cell_id)",
      "items": [
        "ok: status, cell_id, site_id, region, window_end",
        "kpis{4}, breaches[{kpi,value,threshold,rule}]",
        "suggested_priority P1/P2/NONE, open_ticket_id",
        "error: status, error_code, message"
      ]
    },
    {
      "dot": "orange",
      "title": "Contract: create_ticket(cell_id, priority)",
      "items": [
        "created: status, ticket_id, priority, summary",
        "exists: status, ticket_id, priority",
        "error: INVALID_CELL_ID / INVALID_PRIORITY",
        "error: CELL_NOT_FOUND / PRIORITY_NOT_JUSTIFIED"
      ]
    },
    {
      "dot": "slate",
      "title": "Working tree differs from pinned commit",
      "items": [
        "Uncommitted: OPEN_ROUTER_KEY routes the model via LiteLlm/OpenRouter",
        "Uncommitted: custom dashboard chat bypasses the ADK Runner"
      ]
    }
  ]
