  "cards": [
    {
      "dot": "cyan",
      "title": "Division of labour",
      "items": [
        "The LLM follows the triage instruction and chooses which tool to call",
        "Tools re-check thresholds and priority in Python, so the model cannot override them",
        "The agent has only two tools and cannot change the network"
      ]
    },
    {
      "dot": "rose",
      "title": "Guardrails in code",
      "items": [
        "Cell id must match CELL-dddd; unknown cells return an error",
        "P1 needs availability below 95%; P2 needs at least one KPI breach",
        "An already-open ticket is returned instead of creating a duplicate",
        "Ticket summary is built from KPI data, never from user text"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two entry points",
      "items": [
        "Agent path: operator chats with the ADK agent, which calls the tools",
        "Dashboard path: FastAPI calls the same tools directly with a stand-in tool context",
        "Dashboard chat panel reaches the agent through an ADK Runner"
      ]
    },
    {
      "dot": "amber",
      "title": "Data",
      "items": [
        "KPI snapshot and fixture tickets are read from files bundled in the package",
        "Tickets created at runtime live only in session state"
      ]
    }
  ]
