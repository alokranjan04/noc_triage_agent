# Copy to noc_triage_agent/.env and fill in. Never commit the real .env.

# Option A: Gemini API key (recommended for getting started)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key
# Option B: Vertex AI (uncomment and fill project id)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Model id — use the current GA Flash model (check Model Garden for latest)
NOC_AGENT_MODEL=gemini-3.8-flash

# Deployment (only needed for T11-T13)
STAGING_BUCKET=gs://your-project-id-adk-staging
SERVICE_NAME=noc-triage-agent
