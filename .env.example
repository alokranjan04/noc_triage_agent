# Copy to noc_triage_agent/.env and fill in. Never commit the real .env.

# --- LLM Provider (pick one) ---

# Option A: OpenRouter (recommended — cheapest, no GCP model access needed)
OPEN_ROUTER_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Option B: Gemini API key (fallback if no OpenRouter key)
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-gemini-api-key
# NOC_AGENT_MODEL=gemini-2.5-flash

# --- GCP (only needed for Cloud Run deployment) ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
SERVICE_NAME=noc-triage-agent
